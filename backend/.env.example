# Copiá este archivo como .env (en esta misma carpeta) y completá los valores.
# El .env no se sube al repo.

# Base PostgreSQL. Usá una base de desarrollo, no la de producción.
DATABASE_URL=jdbc:postgresql://localhost:5432/utn_tracker
DATABASE_USER=postgres
DATABASE_PASSWORD=

# Clave para firmar los JWT, en Base64 (mínimo 32 bytes).
# Para generar una: openssl rand -base64 32
JWT_SECRET=

# Origen del frontend (opcional, por defecto http://localhost:3000)
# CORS_ALLOWED_ORIGINS=http://localhost:3000
